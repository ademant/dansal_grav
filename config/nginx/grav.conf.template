# Grav CMS - Nginx server config with Let's Encrypt (Certbot) TLS
#
# This is the FINAL config: HTTP redirects to HTTPS, HTTPS serves the site.
# Do not deploy this until a certificate already exists at
# /etc/letsencrypt/live/__DOMAIN__/ - see grav-bootstrap.conf.template and
# ../README.md for the first-issuance flow.
#
# Placeholders to replace (see ../README.md, or use render.sh):
#   __DOMAIN__           e.g. example.com
#   __WEBROOT__          e.g. /srv/grav/dansal_grav
#   __PHP_FPM_SOCK__     e.g. unix:/run/php/php8.4-fpm.sock
#   __CERTBOT_WEBROOT__  e.g. /var/www/certbot

# ---------------------------------------------------------------------------
# HTTP - keeps the ACME challenge reachable for renewals, redirects the rest
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root __CERTBOT_WEBROOT__;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# HTTPS - main Grav site
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on; # nginx < 1.25.1: use `listen 443 ssl http2;` above instead
    server_name __DOMAIN__ www.__DOMAIN__;

    root __WEBROOT__;
    index index.php index.html;

    # --- TLS certificate (issued by certbot) ---
    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/__DOMAIN__/chain.pem;

    # --- TLS settings (Mozilla "intermediate" profile, ECDHE-only so no
    #     separate dhparam file is needed) ---
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:GravSSL:10m;
    ssl_session_tickets off;

    # OCSP stapling (needs outbound resolver access)
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    # Only add HSTS once you've confirmed HTTPS works for the domain (and
    # www. variant, if used) - it's hard to safely walk back once cached by
    # browsers. Start with a short max-age while testing, then raise it.
    # add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;

    # Renewals still hit this over plain HTTP via the :80 server block above,
    # but harmless to also serve it here.
    location ^~ /.well-known/acme-challenge/ {
        root __CERTBOT_WEBROOT__;
        default_type "text/plain";
        try_files $uri =404;
    }

    ## Begin - Index
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
    ## End - Index

    ## Begin - Security (Grav)
    location ~* ^/(\.git|cache|bin|logs|backup|tests)/.*$ { return 403; }
    location ~* ^/user/(config|env)/.*$ { return 403; }
    location ~* ^/user/accounts/[^/]+/[^/]+\.(jpe?g|png|gif|webp|avif|bmp|ico)$ { try_files $uri =404; }
    location ~* ^/user/accounts/.*$ { return 403; }
    location ~* ^/user/data/.*\.(jpe?g|png|gif|webp|avif|bmp|ico|mp4|webm|ogg|ogv|mov|mp3|wav|m4a|flac|pdf)$ { try_files $uri =404; }
    location ~* ^/user/data/.*$ { return 403; }
    location ~* ^/(system|vendor)/.*\.(txt|xml|md|html|htm|shtml|shtm|json|yaml|yml|php|php2|php3|php4|php5|phar|phtml|pl|py|cgi|twig|sh|bat)$ { return 403; }
    location ~* ^/user/.*\.(txt|md|json|yaml|yml|php|php2|php3|php4|php5|phar|phtml|pl|py|cgi|twig|sh|bat)$ { return 403; }
    location ~ ^/(LICENSE\.txt|composer\.lock|composer\.json|nginx\.conf|web\.config|htaccess\.txt|\.htaccess) { return 403; }
    location ~ /\.env(\.|$) { return 403; }
    ## End - Security

    ## Begin - PHP
    location ~ \.php$ {
        fastcgi_pass __PHP_FPM_SOCK__;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/$fastcgi_script_name;
        fastcgi_param HTTPS on;
    }
    ## End - PHP

    client_max_body_size 64m;

    access_log /var/log/nginx/__DOMAIN__.access.log;
    error_log  /var/log/nginx/__DOMAIN__.error.log;
}
